# Lo crea Vercel automáticamente al conectar un Blob Store al proyecto
BLOB_READ_WRITE_TOKEN=""
# URL pública de la nueva app, ej. https://mi-app.vercel.app
NEXT_PUBLIC_SITE_URL=""
